# Secrets: the API key lives only in .env, never in git
.env

# Hackathon material from ITSG stays local (not ours to publish)
data/specs/*
data/samples/*
!data/specs/.gitkeep
!data/samples/.gitkeep

# Generated at runtime
.cache/
*.db
output/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Editors / OS
.vscode/
~$*
.DS_Store
