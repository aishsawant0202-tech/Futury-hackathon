# Copy this file to .env and fill in the real values. .env is never committed.
# hessian.AI gateway (OpenAI-compatible). One key per team: do not share it outside the team.
LLM_BASE_URL=https://hip-gw.hessian.ai/v1
LLM_API_KEY=put-the-team-key-here

# Kolibri-1 (Aleph Alpha): German-optimised, best for reading the German rulebook
LLM_MODEL_GERMAN=vllm/Kolibri-1
# GLM-5.3-Flash (Z.ai): strong at coding and multi-step agent work
LLM_MODEL_CODE=vllm/GLM-5.3-Flash

# Where the ITSG documents are (default: data/specs and data/samples in this repo)
SPEC_DIR=data/specs
SAMPLE_DIR=data/samples
